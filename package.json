{
  "name": "murmur",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './services/**' run build",
    "generate": "pnpm -r run generate",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && pnpm run lint:boundaries",
    "lint:boundaries": "tsx scripts/check-boundaries.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:check": "pnpm -r run generate:check && pnpm run sync:generated:check",
    "perf:budget": "tsx scripts/perf-budget.ts",
    "sync:generated": "tsx scripts/sync-generated.ts",
    "sync:generated:check": "tsx scripts/sync-generated.ts --check",
    "unity:compile-check": "sh scripts/unity-compile-check.sh",
    "android:build": "cd apps/mobile/android && ./gradlew :app:assembleDebug",
    "unity:test": "sh scripts/unity-test.sh",
    "unity:export:android": "sh scripts/unity-export.sh android",
    "unity:export:ios": "sh scripts/unity-export.sh ios",
    "unity:export:ios-simulator": "sh scripts/unity-export.sh ios-simulator",
    "unity:framework:ios": "sh scripts/unity-build-ios-framework.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@murmur/ai-character": "workspace:*",
    "@murmur/face-protocol": "workspace:*",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
